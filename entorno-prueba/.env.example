# Copia este archivo como .env y pon las llaves. NUNCA subas el .env real.
#
# CULQI_PUBLIC_KEY: la llave pública (pk_...). Es pública (va en el navegador).
#   Para pruebas sin dinero real usa las llaves de TEST del panel de Culqi.
# CULQI_SECRET_KEY: la llave secreta (sk_...). NO se comparte ni se sube a git.
# MONTO_CENTIMOS: monto del cargo en céntimos. 100 = S/ 1.00.

CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
MONTO_CENTIMOS=100
